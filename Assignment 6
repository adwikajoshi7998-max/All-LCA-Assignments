With recursion

#include<stdio.h>
int fact_rec(int num);
int main()
{
int num;
int result;
printf("Enter the number :");
scanf("%d",&num);
result = fact_rec(num);
printf("Result =%d \n",result);
return 0;
}
int fact_rec(int num)
{
if(num==1)
return 1;
else
return num*fact_rec(num-1);
}


Without recursion

#include<stdio.h>
int fact_loop(int num);
//int fact_loop(int );
int main()
{
int num;
int result;
printf("Enter the number :");
scanf("%d",&num);
result=fact_loop(num);
printf("Result =%d \n",result);
return 0;
}
int fact_loop(int n)
{
int i,ans =1;
for(i=1;i<=n;i++)
{
ans =ans*i;   //1 2 6 24
}
return ans;
}
